{
  "name": "@logan-luo/dsh-session-cost-bundle",
  "description": "Installable bundle for session cost: the ledger service and the cost surfaces over any dsh profile",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realLoganLuo/dsh-session-cost.git",
    "directory": "packages/session-cost-bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <5.0.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.2.0-0"
  },
  "dependencies": {
    "@logan-luo/dsh-client-ui-session-cost": "workspace:^",
    "@logan-luo/dsh-session-cost": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.0 <5.0.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.2.0-0",
    "typescript": "^5.5.0",
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "node ../../scripts/prepare.mjs"
  }
}
